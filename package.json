{
	"name": "cursor-multisession",
	"displayName": "MultiSession + WeChat",
	"description": "Cursor AI 多会话管理面板 + 微信桥接",
	"version": "0.7.8",
	"publisher": "local",
	"license": "MIT",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "multiSession",
					"title": "MultiSession",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"multiSession": [
				{
					"type": "webview",
					"id": "multiSession.panel",
					"name": "MultiSession"
				},
				{
					"type": "webview",
					"id": "multiSession.wechat",
					"name": "WeChat"
				}
			]
		},
		"commands": [
			{
				"command": "multiSession.install",
				"title": "MultiSession: 安装 MCP 配置"
			},
			{
				"command": "multiSession.uninstall",
				"title": "MultiSession: 卸载 MCP 配置"
			},
			{
				"command": "multiSession.shareFile",
				"title": "MultiSession: 发送文件到输入框"
			},
			{
				"command": "multiSession.copyRule",
				"title": "MultiSession: 复制通信规则"
			},
			{
				"command": "multiSession.wechatLogin",
				"title": "WeChat: 扫码登录"
			},
			{
				"command": "multiSession.wechatConnect",
				"title": "WeChat: 连接"
			},
			{
				"command": "multiSession.wechatDisconnect",
				"title": "WeChat: 断开"
			},
			{
				"command": "multiSession.wechatStatus",
				"title": "WeChat: 查看状态"
			},
			{
				"command": "multiSession.wechatScreenshot",
				"title": "WeChat: 截图发送"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "multiSession.shareFile",
					"group": "navigation@100"
				}
			]
		}
	},
	"scripts": {
		"compile:wechat": "esbuild src/wechat/engine.ts --bundle --outfile=dist/wechat-engine.js --format=cjs --platform=node --minify",
		"compile:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:./wechat-engine.js --format=cjs --platform=node --minify",
		"compile:css": "node -e \"const fs=require('fs');fs.copyFileSync('src/webview/webview.css','dist/webview.css');fs.copyFileSync('src/wechat-webview/wechat.css','dist/wechat-webview.css');fs.mkdirSync('dist/hooks',{recursive:true});fs.copyFileSync('src/hooks/check-queue.sh','dist/hooks/check-queue.sh');fs.chmodSync('dist/hooks/check-queue.sh',0o755)\"",
		"compile:webview": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview.js --format=iife --platform=browser --minify && npm run compile:css",
		"compile:wechat-webview": "esbuild src/wechat-webview/index.tsx --bundle --outfile=dist/wechat-webview.js --format=iife --platform=browser --minify",
		"compile:mcp": "esbuild mcp-server/index.ts --bundle --outfile=dist/mcp-server.mjs --format=esm --platform=node --minify",
		"compile:swift": "node scripts/compile-swift.js",
		"compile": "npm run compile:swift && npm run compile:wechat && npm run compile:ext && npm run compile:webview && npm run compile:wechat-webview && npm run compile:mcp",
		"build": "npm run compile",
		"watch:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
		"watch:webview": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview.js --format=iife --platform=browser --watch",
		"watch": "npm run compile:css && npm run watch:ext & npm run watch:webview",
		"deploy": "npm run build && node scripts/deploy.js",
		"release": "node scripts/release.js",
		"dev": "node scripts/watch.js",
		"package": "npm run build && npx @vscode/vsce package --no-dependencies"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.1",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@types/vscode": "^1.80.0",
		"esbuild": "^0.20.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"typescript": "^5.0.0"
	}
}
